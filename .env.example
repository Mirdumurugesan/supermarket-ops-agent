# ─── Telegram ──────────────────────────────────────────────────────────────
# From @BotFather on Telegram: /newbot → copy the token here.
TELEGRAM_BOT_TOKEN=

# ─── Model chain ───────────────────────────────────────────────────────────
# Comma-separated, best first. A model whose key is missing is dropped at
# startup with a warning, so this same file works with one key or three.
#
# Groq is the primary: free, no credit card, very fast. It meters 8,000
# tokens/minute *per model*, and this agent sends ~3,850 tokens of tool schema
# per request — so a busy minute returns 429 and the chain moves on.
#   → console.groq.com/keys
# Gemini is the safety net behind both Groq models: also free, no card, and a
# much wider window.
#   → aistudio.google.com/apikey
#
# Every link below is free. Append openai:gpt-4o-mini if you want a paid last
# resort (~₹0.40 for a full demo run); it is dropped automatically when
# OPENAI_API_KEY is blank.
KIRANA_MODELS=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,google:gemini-3.6-flash

GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Other providers work too — anthropic:, cerebras:, mistral:, xai:

# ─── Store ─────────────────────────────────────────────────────────────────
KIRANA_DB_PATH=data/kirana.db

# Optional: restrict the bot to specific Telegram user ids (comma-separated).
# Leave empty to let anyone message it — fine for a review demo.
ALLOWED_USER_IDS=
