# ─── Telegram ──────────────────────────────────────────────────────────────
# From @BotFather on Telegram: /newbot → copy the token here.
TELEGRAM_BOT_TOKEN=8885905418:AAGk3Uj8mlYSOsL602tYytsjYSa572AKFP0

# ─── Model chain ───────────────────────────────────────────────────────────
# Comma-separated, best first. A model whose key is missing is dropped at
# startup with a warning, so this same file works with one key or three.
#
# Groq is the primary: free, no credit card, very fast.
#   → console.groq.com/keys
# OpenAI catches Groq's rate limits (its free tier is 6k tokens/min, and this
# agent sends ~4.3k tokens of tool schema per request, so a busy minute 429s).
# OpenAI is PAID — roughly ₹0.40 for a full demo run on gpt-4o-mini.
#   → platform.openai.com/api-keys
#
# Leave OPENAI_API_KEY blank to run Groq-only at zero cost. The bot works; it
# just gets slower for a minute when the free quota is hit instead of failing
# over.
KIRANA_MODELS=groq:llama-3.3-70b-versatile,openai:gpt-4o-mini

GROQ_API_KEY=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
OPENAI_API_KEY=

# Other providers work too — anthropic:, google:, cerebras:, mistral:, xai:
# e.g. KIRANA_MODELS=groq:llama-3.3-70b-versatile,google:gemini-2.5-flash

# ─── Store ─────────────────────────────────────────────────────────────────
KIRANA_DB_PATH=data/kirana.db

# Optional: restrict the bot to specific Telegram user ids (comma-separated).
# Leave empty to let anyone message it — fine for a review demo.
ALLOWED_USER_IDS=
